{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "Node16",
		"moduleResolution": "Node16",
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"alwaysStrict": true,
		"skipLibCheck": true,
		"strict": true,
		"useUnknownInCatchVariables": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"typeRoots": ["./node_modules/@types", "shared/types"],
		"types": ["node"]
	},
	"include": ["**/*.js", "**/*.cjs", "shared/types/**/*.d.ts"],
	"exclude": ["**/node_modules/**", "release/**/*"]
}
